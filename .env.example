# CaptchaService Configuration
# Copy file này thành .env và sửa giá trị

# API Key - để rỗng = dev mode (không check auth)
CAPTCHA_API_KEY=

# Server port (mặc định 8000)
PORT=8000

# TCT endpoints
TCT_CAPTCHA_URL=https://hoadondientu.gdt.gov.vn:30000/captcha
TCT_AUTH_URL=https://hoadondientu.gdt.gov.vn:30000/security-taxpayer/authenticate
